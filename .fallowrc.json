{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    "entry": [
        "code/backend/test/**/*.test.ts",
        "code/backend/src/module/*/test/*.test.ts",
        "code/backend/src/module/*/service/**/*.operation.ts"
    ],
    "ignorePatterns": [
        "**/script/**",
        "script/**",
        "**/test/linter/**",
        "**/test/*linter*.test.ts",
        "**/test/*scaffold*.test.ts",
        "**/test/module.tools.test.ts",
        "**/test/test.catalog.test.ts",
        "**/test/deployment.test.ts",
        "**/generated/**",
        "code/backend/src/module/*/service/*.service.ts"
    ],
    "ignoreDependencies": [
        "@babel/parser",
        "@vue/compiler-sfc",
        "postcss-value-parser",
        "vite-plugin-pwa",
        "workbox-core",
        "workbox-precaching",
        "workbox-routing",
        "workbox-strategies"
    ],
    "workspaces": {
        "patterns": [
            "code/backend",
            "code/frontend/web"
        ]
    }
}
