# Optional explicit presentation lock: desktop, tablet, or mobile.
# Leave unset to use confident device hints with live viewport fallback.
VITE_PRESENTATION_LOCK=

# Backend origin or path used by the central ApiClient.
VITE_API_BASE_URL=/

# Production deployments inject these public values through runtime-config.js.
# FRONTEND_API_BASE_URL=https://api.example.com
# FRONTEND_WEBSOCKET_URL=wss://api.example.com
# FRONTEND_PRESENTATION_LOCK=null
