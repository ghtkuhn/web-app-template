        "lint:backend": "npm run lint",
        "module:status": "node script/module-tools.ts status",
        "module:sync": "node script/module-tools.ts sync",
        "module:dependency": "node script/module-tools.ts dependency",
        "scaffold:file": "node script/scaffold-file.ts",
        "scaffold:module": "node script/scaffold-module.ts",
        "scaffold:operation": "node script/scaffold-operation.ts",
        "scaffold:test": "node script/scaffold-test.ts",
        "typecheck": "tsc --project tsconfig.json",
        "verify:module": "node script/module-tools.ts verify",
        "generate:test-catalog": "node script/test-catalog.ts generate",
        "check:test-catalog": "node script/test-catalog.ts check",
        "test": "npm run check:test-catalog && node script/test-runner.ts"
    }
