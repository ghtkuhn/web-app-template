    "dependencies": {
        "better-auth": "^1.6.26",
        "better-sqlite3": "^12.11.1",
        "kysely": "^0.27.0",
        "pg": "^8.23.0",
        "uuid": "^9.0.0",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^12.1.0",
        "@babel/parser": "^8.0.4",
        "@redocly/cli": "^2.40.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.20.1",
        "@types/pg": "^8.21.0",
        "@types/uuid": "^9.0.0",
        "@types/ws": "^8.18.1",
        "ajv": "^8.20.0"
    },
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "cli": "node src/cli.ts",
        "check:modules": "node script/module-tools.ts check",
        "lint": "npm run lint:architecture && npm run lint:openapi",
        "lint:architecture": "node script/linter.ts",
