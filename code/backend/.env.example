# Application
NODE_ENV=development
LOG_LEVEL=info
APP_SECRET=replace-with-a-secure-random-secret
ACTIVE_MODULES=health
ALLOWED_ORIGINS=http://localhost:8080

# HTTP transport
HTTP_ENABLED=true
PORT=3000

# WebSocket transport
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3001
WEBSOCKET_MAX_MESSAGE_BYTES=1048576
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000

# CLI transport
CLI_ENABLED=true

# Database
# SQLite is currently the only supported database type.
DB_TYPE=sqlite
DB_SQLITE_PATH=data/sqlite/backend.sqlite
DB_BACKUP_RETENTION=10
# Set automatically by deployment tooling; useful for local migration testing.
DEPLOYMENT_RELEASE_ID=development

# Reserved for the future PostgreSQL implementation.
# Setting DB_TYPE=postgres currently causes a controlled startup error.
# DB_POSTGRES_HOST=localhost
# DB_POSTGRES_PORT=5432
# DB_POSTGRES_USER=postgres
# DB_POSTGRES_PASSWORD=replace-with-a-secure-password
# DB_POSTGRES_NAME=backend_db
