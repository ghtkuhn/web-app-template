# Application
NODE_ENV=development
LOG_LEVEL=info
APP_SECRET=
ACTIVE_MODULES=health
ALLOWED_ORIGINS=http://localhost:8080

# Better Auth is included but inactive by default.
AUTH_ENABLED=false
AUTH_REGISTRATION_ENABLED=false
BETTER_AUTH_BASE_URL=http://localhost:3000
# Required with at least 32 high-entropy characters when AUTH_ENABLED=true.
BETTER_AUTH_SECRET=

# HTTP transport
HTTP_ENABLED=true
PORT=3000
HTTP_MAX_BODY_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000

# WebSocket transport
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3001
WEBSOCKET_MAX_MESSAGE_BYTES=1048576
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000

# CLI transport
CLI_ENABLED=true

# Database
# SQLite remains the default database type.
DB_TYPE=sqlite
DB_SQLITE_PATH=data/sqlite/backend.sqlite
DB_BACKUP_RETENTION=10
# Set automatically by deployment tooling; useful for local migration testing.
DEPLOYMENT_RELEASE_ID=development

# To use an externally managed PostgreSQL database, set DB_TYPE=postgres and
# provide its secret URL. Production requires postgresql: and sslmode=verify-full.
# DATABASE_URL=
# DB_POSTGRES_POOL_MAX=10
# DB_POSTGRES_IDLE_TIMEOUT_MS=30000
# DB_POSTGRES_CONNECTION_TIMEOUT_MS=10000
