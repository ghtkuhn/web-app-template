# Required by backend deployment.
APP_SECRET=replace-with-a-secure-random-secret

# Required only by backend profiles selecting external PostgreSQL.
# Production URLs must use postgresql: with sslmode=verify-full.
DATABASE_URL=postgresql://user:password@database.example/app?sslmode=verify-full

# Required only by profiles using the Proxmox LXC driver.
PROXMOX_API_TOKEN_ID=deploy@pve!web-app
PROXMOX_API_TOKEN_SECRET=replace-with-proxmox-api-token-secret
DEPLOYMENT_SSH_PRIVATE_KEY=/absolute/path/to/lxc-deployment-key
