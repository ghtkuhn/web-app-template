{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/deployment-profile.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "name", "environment", "requiredSecrets", "backend", "frontend"],
    "properties": {
        "schemaVersion": { "enum": [1, 2] },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "environment": { "enum": ["local", "dev", "staging", "prod"] },
        "requiredSecrets": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "backend": { "$ref": "#/$defs/backend" },
        "frontend": { "$ref": "#/$defs/frontend" }
    },
    "$defs": {
        "disabled": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": { "enabled": { "const": false } }
        },
        "dockerTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["driver", "image", "hostPort"],
            "properties": {
                "driver": { "const": "docker" },
                "image": { "type": "string", "minLength": 1 },
                "hostPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
        },
        "lxcTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["driver", "installationId", "apiUrl", "node", "vmid", "hostname", "storage", "template", "bridge", "address", "gateway", "nameserver", "firewall", "startOnBoot", "stopContainer", "sshAuthentication", "sshHost", "sshPort", "sshUser", "sshHostKeyFingerprint", "sshPublicKey", "cores", "memoryMb", "swapMb", "diskGb"],
            "properties": {
                "driver": { "const": "proxmox-lxc" },
                "installationId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
                "apiUrl": { "type": "string", "format": "uri" },
                "node": { "type": "string", "minLength": 1 },
                "vmid": { "type": "integer", "minimum": 100 },
                "hostname": { "type": "string", "minLength": 1 },
                "storage": { "type": "string", "minLength": 1 },
                "template": { "type": "string", "minLength": 1 },
                "bridge": { "type": "string", "minLength": 1 },
                "address": { "type": "string", "minLength": 1 },
                "gateway": { "type": "string", "minLength": 1 },
                "nameserver": { "type": "string", "minLength": 1 },
                "firewall": { "type": "boolean" },
                "startOnBoot": { "type": "boolean" },
                "stopContainer": { "type": "boolean" },
                "sshHost": { "type": "string", "minLength": 1 },
                "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "sshUser": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" },
                "sshAuthentication": { "enum": ["private-key", "password"] },
                "sshHostKeyFingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" },
                "sshPublicKey": { "type": "string", "minLength": 1 },
                "cores": { "type": "integer", "minimum": 1 },
                "memoryMb": { "type": "integer", "minimum": 128 },
                "swapMb": { "type": "integer", "minimum": 0 },
                "diskGb": { "type": "integer", "minimum": 2 },
                "allowInsecureTls": { "type": "boolean", "default": false }
            }
        },
        "existingLxcTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["driver", "installationId", "sshAuthentication", "sshHost", "sshPort", "sshUser", "sshHostKeyFingerprint"],
            "properties": {
                "driver": { "const": "existing-lxc" },
                "installationId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
                "sshAuthentication": { "enum": ["private-key", "password"] },
                "sshHost": { "type": "string", "minLength": 1 },
                "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "sshUser": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" },
                "sshHostKeyFingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" }
            }
        },
        "target": {
            "oneOf": [
                { "$ref": "#/$defs/dockerTarget" },
                { "$ref": "#/$defs/lxcTarget" },
                { "$ref": "#/$defs/existingLxcTarget" }
            ]
        },
        "sqliteDatabase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path", "backupRetention"],
            "properties": {
                "type": { "const": "sqlite" },
                "path": { "type": "string", "minLength": 1 },
                "backupRetention": { "type": "integer", "minimum": 1 }
            }
        },
        "postgresDatabase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "connectionUrlSecret", "backupStrategy"],
            "properties": {
                "type": { "const": "postgres" },
                "connectionUrlSecret": { "const": "DATABASE_URL" },
                "backupStrategy": { "const": "external" },
                "poolMax": { "type": "integer", "minimum": 1 },
                "idleTimeoutMs": { "type": "integer", "minimum": 0 },
                "connectionTimeoutMs": { "type": "integer", "minimum": 0 }
            }
        },
        "database": {
            "oneOf": [
                { "$ref": "#/$defs/sqliteDatabase" },
                { "$ref": "#/$defs/postgresDatabase" }
            ]
        },
        "backend": {
            "oneOf": [
                { "$ref": "#/$defs/disabled" },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["enabled", "target", "publicHttpUrl", "publicWebSocketUrl", "allowedOrigins", "activeModules", "authRegistrationEnabled", "sqlitePath"],
                    "properties": {
                        "enabled": { "const": true },
                        "target": { "$ref": "#/$defs/target" },
                        "publicHttpUrl": { "type": "string", "format": "uri" },
                        "publicWebSocketUrl": { "type": "string", "format": "uri" },
                        "allowedOrigins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
                        "activeModules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                        "authRegistrationEnabled": { "type": "boolean" },
                        "sqlitePath": { "type": "string", "minLength": 1 },
                        "databaseBackupRetention": { "type": "integer", "minimum": 1, "default": 10 }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["enabled", "target", "publicHttpUrl", "publicWebSocketUrl", "allowedOrigins", "activeModules", "authRegistrationEnabled", "database"],
                    "properties": {
                        "enabled": { "const": true },
                        "target": { "$ref": "#/$defs/target" },
                        "publicHttpUrl": { "type": "string", "format": "uri" },
                        "publicWebSocketUrl": { "type": "string", "format": "uri" },
                        "allowedOrigins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
                        "activeModules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                        "authRegistrationEnabled": { "type": "boolean" },
                        "database": { "$ref": "#/$defs/database" }
                    }
                }
            ]
        },
        "frontend": {
            "oneOf": [
                { "$ref": "#/$defs/disabled" },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["enabled", "target", "publicUrl", "runtime"],
                    "properties": {
                        "enabled": { "const": true },
                        "target": { "$ref": "#/$defs/target" },
                        "publicUrl": { "type": "string", "format": "uri" },
                        "runtime": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["apiBaseUrl", "webSocketUrl", "presentationLock", "authEnabled", "registrationEnabled"],
                            "properties": {
                                "apiBaseUrl": { "type": "string", "format": "uri" },
                                "webSocketUrl": { "type": "string", "format": "uri" },
                                "presentationLock": { "enum": ["desktop", "tablet", "mobile", null] },
                                "authEnabled": { "type": "boolean" },
                                "registrationEnabled": { "type": "boolean" }
                            }
                        }
                    }
                }
            ]
        }
    }
}
